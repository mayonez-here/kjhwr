{
  "installCommand": "cd frontend && npm ci --no-audit --no-fund",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": { "includeFiles": "{backend,data}/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
